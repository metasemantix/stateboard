{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stateboard",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "stateboard",
    "database_id": "LOCAL_OR_OPERATOR_PROVIDED_DATABASE_ID",
    "migrations_dir": "migrations"
  }]
}
